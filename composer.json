{
    "name": "felkyo/creatures",
    "description": "Felkyo Creatures — a cosy creature-collecting website built as a learning project and a foundation for a beginner to extend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "league/plates": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Felkyo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Felkyo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cakephp/plugin-installer": false
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
