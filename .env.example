# Felkyo Creatures — example environment file.
#
# HOW TO USE: copy this file to ".env" (same folder) and fill in the real values
# for your machine. The real ".env" is never committed to Git because it holds
# secrets. This ".env.example" IS committed, so everyone knows which settings
# exist and what they mean.
#
# On a fresh XAMPP install the MySQL/MariaDB "root" user has no password, so the
# defaults below usually work as-is for local development.

# ---- Application ----
# APP_ENV is "development" on your machine and "production" on the live server.
APP_ENV=development
# APP_DEBUG=true shows detailed errors while developing. Set to false in production.
APP_DEBUG=true

# ---- Closed-demo settings (Phase D) ----
# Whether anyone can create an account. If you leave these out entirely, sensible
# defaults apply: registration is OPEN in development and CLOSED in production,
# and the demo banner is hidden in development and shown in production. Set them
# explicitly only when you want to override that.
#
# WARNING: opening registration on a live site means taking on real
# responsibilities for real people's data. Read the security note in
# docs/deployment-guide.md before setting this to true in production.
# REGISTRATION_OPEN=true
# Shows the "this is a demo, not a live service" banner. Set to true locally if
# you want to see how it looks.
# SHOW_DEMO_NOTICE=false

# The shared password for the seeded demo accounts. The seed script refuses to run
# without it, rather than inventing a weak one. Pick something long; it is a real
# password protecting accounts on a public URL, even if the data behind them is
# made up. Never commit the real value — it belongs in .env only.
DEMO_ACCOUNT_PASSWORD=

# ---- Database (local XAMPP MariaDB) ----
# The host and port MariaDB listens on. XAMPP's default is 127.0.0.1 port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
# The database (schema) the app uses. The tests use a SEPARATE database
# (felkyo_test) so they can never touch your real data.
DB_NAME=felkyo
# The MariaDB user and password. XAMPP's default root user has an empty password.
DB_USER=root
DB_PASSWORD=
